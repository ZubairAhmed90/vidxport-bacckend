PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
MAX_DOWNLOAD_MB=250
LOG_LEVEL=info

# YouTube resolution backend (only needed for the /youtube page).
# Production: install yt-dlp on the server (single binary) and either add it to PATH
# or point YTDLP_PATH at it. Modern YouTube needs a JS runtime (deno is the default)
# to unlock formats, and ffmpeg to merge DASH audio+video into one MP4.
#
# Install once:
#   - yt-dlp:   https://github.com/yt-dlp/yt-dlp/releases  (or: winget install yt-dlp.yt-dlp)
#   - deno:     https://deno.land  (or: winget install DenoLand.Deno) — YouTube JS runtime
#   - ffmpeg:   https://www.gyan.dev/ffmpeg/builds/        (or: winget install yt-dlp.FFmpeg)
#
# Paths below (absolute or bare names if on PATH):
YTDLP_PATH=yt-dlp
# DENO_PATH=C:\path\to\deno.exe
# FFMPEG_LOCATION=C:\path\to\ffmpeg\bin

# Optional concurrency tuning (see server.js defaults)
# CONCURRENT_STREAMS=16